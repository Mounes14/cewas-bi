EVALUATE
VAR t = CALCULATETABLE(Diagnostic, Diagnostic[cewasEDP_DEV] = "__ID__")
VAR c = CALCULATETABLE(Diagnostic, Diagnostic[cewasEDP_DEV] = "__CMP__")
