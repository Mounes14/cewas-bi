ROW("o",2,"s",MAXX(t,[marketpotential_rating_percent]),"p",MAXX(c,[marketpotential_rating_percent]),"u",0),
ROW("o",3,"s",MAXX(t,[customerseg_rating_percent]),"p",MAXX(c,[customerseg_rating_percent]),"u",MAXX(t,INT(ISBLANK([customerseg_segmentsserved_rating]))+INT(ISBLANK([customerseg_needsassessment_rating])))),
